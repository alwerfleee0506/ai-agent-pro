+# Schema initialization is retried with bounded waits. No user data is reset.
+DB_SCHEMA_READY=False
+_db_init_lock=threading.Lock()
+_db_retry_after=0.0
+
+
+def initialize_database(attempts=3):
+    global DB_SCHEMA_READY,_db_retry_after
+    if DB_SCHEMA_READY:return True
+    if time.monotonic()<_db_retry_after:return False
+    if not _db_init_lock.acquire(blocking=False):return False
+    try:
+        if DB_SCHEMA_READY:return True
+        if not DATABASE_URL:
+            _db_retry_after=time.monotonic()+30
+            app.logger.error('Database initialization unavailable: configuration missing')
+            return False
+        for attempt in range(max(1,min(3,attempts))):
+            try:
+                init_db()
+                DB_SCHEMA_READY=True
+                _db_retry_after=0.0
+                return True
+            except Exception as exc:
+                # Log type only; connection errors may contain private infrastructure details.
+                app.logger.error('Database initialization attempt %s failed: %s',attempt+1,type(exc).__name__)
